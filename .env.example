# TEMPLATE ONLY. Inject real values privately; the app does not auto-load .env.
# Compose's .env handling applies only to its PostgreSQL container settings.
POSTGRES_DB=ctrltea
POSTGRES_USER=ctrltea_migrator
POSTGRES_PASSWORD=
CTRLTEA_PG_PORT=5432
CTRLTEA_DB_BACKEND=postgres
CTRLTEA_AUTH_MODE=required
# Offline operator only; remove from the API/worker environment after setup.
CTRLTEA_MIGRATION_URL=
CTRLTEA_RUNTIME_PASSWORD=
CTRLTEA_AUTH_DB_PASSWORD=
CTRLTEA_RUNTIME_ROLE=ctrltea_app
# Separate restricted runtime identities; never use the migrator here.
CTRLTEA_DATABASE_URL=
CTRLTEA_AUTH_DATABASE_URL=
CTRLTEA_AUTH_SECRET=
CTRLTEA_PUBLIC_ORIGIN=https://studio.example.invalid
CTRLTEA_COOKIE_SECURE=1
CTRLTEA_DATA_DIR=
CTRLTEA_PROFILE_DIR=
# For local development ONLY: PUBLIC_ORIGIN=http://localhost:8765,
# COOKIE_SECURE=0; launch on loopback and open that exact origin.
CTRLTEA_MAIL_PROVIDER=local
CTRLTEA_MAIL_SINK=
CTRLTEA_MAIL_FROM=Ctrl+Tea <noreply@example.invalid>
CTRLTEA_SMTP_HOST=
CTRLTEA_SMTP_PORT=587
CTRLTEA_SMTP_USER=
CTRLTEA_SMTP_PASSWORD=
# Never set AUTH_MODE=local on a service available to other people.
# WORKSPACE_ID and ALLOW_UNCLAIMED are legacy offline tools, not user identity.
